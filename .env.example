# Copy to .env and fill in. NEVER commit .env.

# --- Auto.dev Listings API (primary source) ---
AUTODEV_API_KEY=

# Hard monthly cap on Auto.dev calls. Free Starter tier = 1,000/mo;
# we cap at 800 to leave a safety buffer. Enforced by BudgetGuard.
MONTHLY_CALL_CAP_AUTODEV=800

# --- Marketcheck Listings API (secondary source; under evaluation) ---
# Free tier = 500 calls/mo, 5 req/s. Key is passed as a query param.
# Currently used only by `carfinder marketcheck-probe` (radius evaluation).
MARKETCHECK_API_KEY=

# Hard monthly cap on Marketcheck calls; capped under the 500 free-tier limit.
MONTHLY_CALL_CAP_MARKETCHECK=400

# --- Anthropic API (Haiku fallback extraction, M5) ---
ANTHROPIC_API_KEY=

# Hard monthly spend cap for AI calls, in USD.
MONTHLY_AI_BUDGET_USD=2

# --- GM window sticker endpoint (free; ground truth for trim/RPO/paint) ---
# Cap is a runaway-loop backstop, not a paid quota.
MONTHLY_CALL_CAP_GM=500

# --- Storage ---
# SQLite database path (volume-mounted in Docker).
CARFINDER_DB_PATH=data/carfinder.sqlite
# Cached window sticker PDFs (committed fixtures live in tests/, cache here).
CARFINDER_STICKERS_DIR=stickers

# --- Location ---
# Distances shown in the UI are measured from this zip code's centroid.
CARFINDER_HOME_ZIP=77498

# --- Notifications (optional) ---
# ntfy topic URL (https://ntfy.sh/your-topic) or a Discord webhook URL.
# When set, a car scoring at/above NOTIFY_THRESHOLD (total, 0-110) pings it.
NOTIFY_WEBHOOK_URL=
NOTIFY_THRESHOLD=85
